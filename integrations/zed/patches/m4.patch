+/// A viewport pass with an ordered stream of triangle instances. The vertex entry
+/// reads the transform and color at TEXCOORD0 and TEXCOORD1, and generates the
+/// shared geometry from the vertex index. The pixel entry produces opaque color.
+/// The platform renderer owns compilation, the target, and presentation.
+#[derive(Debug)]
+pub struct GpuViewportShader {
+    /// Platform shader source. The Windows renderer consumes shader-model-4.1 HLSL.
+    pub source: String,
+    /// Vertex shader entry point.
+    pub vertex_entry: String,
+    /// Pixel shader entry point.
+    pub pixel_entry: String,
+    /// Static indexed geometry for the depth-tested pass, when supplied.
+    pub mesh: Option<GpuViewportMesh>,
+}
+
+/// One GPU viewport instance, in input-layout order.
+#[derive(Clone, Copy, Debug, PartialEq)]
+#[repr(C)]
+pub struct GpuViewportInstance {
+    /// Clip-space center (x, y) followed by half-size (x, y).
+    pub transform: [f32; 4],
+    /// RGBA vertex color, with opaque alpha.
+    pub color: [f32; 4],
+}
+
+/// Instances in painter's order. Two objects fit inline.
+pub type GpuViewportInstances = SmallVec<[GpuViewportInstance; 2]>;
+
+/// One indexed mesh, with xyz and face brightness per vertex.
+#[derive(Debug)]
+pub struct GpuViewportMesh {
+    /// Immutable vertex data in input-layout order.
+    pub vertices: Vec<[f32; 4]>,
+    /// Triangle indices.
+    pub indices: Vec<u16>,
+    /// Index prefix to draw for the first instance. Zero draws the full mesh for all.
+    pub first_instance_indices: u32,
+}
+
+/// One depth-tested mesh instance, in input-layout order.
+#[derive(Clone, Copy, Debug, PartialEq)]
+#[repr(C)]
+pub struct GpuViewportMeshInstance {
+    /// Four columns of the model-view-projection transform.
+    pub clip_from_model: [[f32; 4]; 4],
+    /// Opaque RGBA color.
+    pub color: [f32; 4],
+}
+
+/// Owned viewport draw data. Mesh instances are shared with the cached surface.
+#[derive(Clone, Debug, PartialEq)]
+pub enum GpuViewportDraw {
+    /// Painter-ordered screen-space marker instances.
+    Triangles(GpuViewportInstances),
+    /// Depth-tested 3D instances of the viewport shader's indexed mesh.
+    Mesh(std::sync::Arc<[GpuViewportMeshInstance]>),
+}
+
+impl GpuViewportDraw {
+    /// Whether the viewport has anything to draw.
+    pub fn is_empty(&self) -> bool {
