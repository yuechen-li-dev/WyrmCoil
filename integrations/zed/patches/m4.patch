+
+impl GpuViewportPass {
+    fn prepare(
+        slot: &mut Option<Self>,
+        surface: &PaintSurface,
+        devices: &DirectXRendererDevices,
+    ) -> Result<()> {
+        let size = viewport_size(surface);
+        let draw = &surface.gpu_viewport_draw;
+        if size.width.0 <= 0 || size.height.0 <= 0 || draw.is_empty() {
+            *slot = None;
+            return Ok(());
+        }
+        if !slot
+            .as_ref()
+            .is_some_and(|pass| Arc::ptr_eq(&pass.shader, &surface.gpu_viewport))
+        {
+            *slot = None;
+            let start = std::time::Instant::now();
+            let shader = surface.gpu_viewport.clone();
+            let vertex = compile_viewport_shader(
+                &shader.source,
+                &shader.vertex_entry,
+                windows::core::s!("vs_4_1"),
+            )?;
+            let pixel = compile_viewport_shader(
+                &shader.source,
+                &shader.pixel_entry,
+                windows::core::s!("ps_4_1"),
+            )?;
+            let mesh = shader
+                .mesh
+                .as_ref()
+                .map(|mesh| GpuViewportMeshState::new(&devices.device, mesh))
+                .transpose()?;
+            let layout = create_viewport_input_layout(&devices.device, &vertex, mesh.is_some())?;
+            let vertex = create_vertex_shader(&devices.device, &vertex)?;
+            let pixel = create_fragment_shader(&devices.device, &pixel)?;
+            *slot = Some(Self {
+                shader,
+                vertex,
+                pixel,
+                layout,
+                mesh,
+                instance_buffer: None,
+                instance_capacity: 0,
+                target: None,
+            });
+            log::info!(
+                "GPU viewport: SM4.1 pipeline ready in {:.2?}",
+                start.elapsed()
+            );
+        }
+        let pass = slot.as_mut().context("viewport pipeline missing")?;
+        anyhow::ensure!(
+            pass.mesh.is_some() == matches!(draw, GpuViewportDraw::Mesh(_)),
+            "viewport draw does not match shader geometry"
+        );
+        if !pass
+            .target
+            .as_ref()
+            .is_some_and(|target| target.size == size)
+        {
+            pass.target = None;
+            pass.target = Some(GpuViewportTarget::new(devices, size, pass.mesh.is_some())?);
+        }
+        if pass.target.as_ref().and_then(|target| target.draw.as_ref()) != Some(draw) {
+            match draw {
+                GpuViewportDraw::Triangles(instances) => {
+                    pass.render(devices, instances.as_slice())?
+                }
+                GpuViewportDraw::Mesh(instances) => pass.render(devices, instances)?,
+            }
+            pass.target.as_mut().unwrap().draw = Some(draw.clone());
+        }
+        Ok(())
+    }
+
+    fn render<T>(&mut self, devices: &DirectXRendererDevices, instances: &[T]) -> Result<()> {
+        let target = self.target.as_mut().context("viewport target missing")?;
+        target.draw = None;
+        let stride = size_of::<T>() as u32;
+        if self.instance_capacity < instances.len() {
+            let capacity = instances
+                .len()
+                .max(2)
+                .checked_next_power_of_two()
+                .context("viewport instance capacity overflow")?;
+            anyhow::ensure!(
+                capacity <= MAX_INSTANCE_BUFFER_SIZE / stride as usize,
+                "viewport instance buffer capacity too large: {capacity}"
+            );
+            let desc = D3D11_BUFFER_DESC {
+                ByteWidth: capacity as u32 * stride,
+                Usage: D3D11_USAGE_DYNAMIC,
+                BindFlags: D3D11_BIND_VERTEX_BUFFER.0 as u32,
+                CPUAccessFlags: D3D11_CPU_ACCESS_WRITE.0 as u32,
+                ..Default::default()
+            };
+            let mut buffer = None;
+            // CreateBuffer initializes the one output and copies the descriptor.
+            unsafe { devices.device.CreateBuffer(&desc, None, Some(&mut buffer)) }?;
+            self.instance_buffer = Some(buffer.context("viewport instance buffer missing")?);
+            self.instance_capacity = capacity;
+            log::debug!("GPU viewport: allocated instance buffer ({capacity} instances)");
+        }
+        let context = &devices.device_context;
+        let buffer = self
+            .instance_buffer
+            .as_ref()
+            .context("viewport instance buffer missing")?;
+        update_buffer(context, buffer, instances).context("upload viewport instances")?;
+        let render_view = target
+            .render_view
+            .as_ref()
+            .context("viewport render view missing")?;
+        let offset = 0;
+        let count = instances.len() as u32;
+        let mut draw_calls = 1;
+        // Layout, stride, and indices are validated before binding. All handles
+        // and pointer arguments stay live until the corresponding call returns.
+        unsafe {
+            context.ClearRenderTargetView(render_view, &[0.0; 4]);
+            if let Some(depth) = &target.depth {
+                context.ClearDepthStencilView(depth, D3D11_CLEAR_DEPTH.0, 0.0, 0);
+            }
+            context.OMSetRenderTargets(
+                Some(slice::from_ref(&target.render_view)),
+                target.depth.as_ref(),
+            );
+            context.OMSetBlendState(None, None, u32::MAX);
+            context.OMSetDepthStencilState(self.mesh.as_ref().map(|mesh| &mesh.depth_state), 0);
+            context.RSSetViewports(Some(&[D3D11_VIEWPORT {
+                Width: target.size.width.0 as f32,
+                Height: target.size.height.0 as f32,
+                MaxDepth: 1.0,
+                ..Default::default()
+            }]));
+            context.IASetPrimitiveTopology(D3D_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+            context.IASetInputLayout(&self.layout);
+            context.VSSetShader(&self.vertex, None);
+            context.PSSetShader(&self.pixel, None);
+            if let Some(mesh) = &self.mesh {
+                let previous_rasterizer = context.RSGetState().ok();
+                context.RSSetState(&mesh.rasterizer);
+                let streams = [Some(mesh.vertices.clone()), self.instance_buffer.clone()];
+                let strides = [size_of::<[f32; 4]>() as u32, stride];
+                let offsets = [0, 0];
+                context.IASetVertexBuffers(
+                    0,
+                    2,
+                    Some(streams.as_ptr()),
+                    Some(strides.as_ptr()),
+                    Some(offsets.as_ptr()),
+                );
+                context.IASetIndexBuffer(&mesh.indices, DXGI_FORMAT_R16_UINT, 0);
+                let first = u32::from(mesh.first_instance_indices > 0);
+                if first == 1 {
+                    context.DrawIndexedInstanced(mesh.first_instance_indices, 1, 0, 0, 0);
+                }
+                if count > first {
+                    context.DrawIndexedInstanced(mesh.index_count, count - first, 0, 0, first);
+                    draw_calls += first;
+                }
+                context.IASetIndexBuffer(None, DXGI_FORMAT_R16_UINT, 0);
+                context.IASetVertexBuffers(
+                    0,
+                    2,
+                    Some([None, None].as_ptr()),
+                    Some(strides.as_ptr()),
+                    Some(offsets.as_ptr()),
+                );
+                context.RSSetState(previous_rasterizer.as_ref());
+            } else {
+                context.IASetVertexBuffers(
+                    0,
+                    1,
+                    Some(&self.instance_buffer),
+                    Some(&stride),
+                    Some(&offset),
+                );
+                context.DrawInstanced(3, count, 0, 0);
+                context.IASetVertexBuffers(0, 1, Some(&None), Some(&stride), Some(&offset));
+            }
+            context.OMSetRenderTargets(None, None);
+            context.OMSetDepthStencilState(None, 0);
+            context.IASetInputLayout(None);
+            context.VSSetShader(None, None);
+            context.PSSetShader(None, None);
+        }
+        log::trace!(
+            "GPU viewport: {draw_calls} draw calls, {} instances, {} uploaded bytes",
+            instances.len(),
+            size_of_val(instances)
+        );
+        Ok(())
+    }
+}
+
+fn create_viewport_input_layout(
+    device: &ID3D11Device,
+    vertex: &[u8],
+    mesh: bool,
+) -> Result<ID3D11InputLayout> {
+    let transform = D3D11_INPUT_ELEMENT_DESC {
+        SemanticName: windows::core::s!("TEXCOORD"),
+        Format: DXGI_FORMAT_R32G32B32A32_FLOAT,
+        InputSlotClass: D3D11_INPUT_PER_INSTANCE_DATA,
+        InstanceDataStepRate: 1,
+        ..Default::default()
+    };
+    let mut elements = vec![transform];
+    if mesh {
+        elements[0].InputSlotClass = D3D11_INPUT_PER_VERTEX_DATA;
+        elements[0].InstanceDataStepRate = 0;
+        for index in 0..5 {
+            elements.push(D3D11_INPUT_ELEMENT_DESC {
+                SemanticIndex: index + 1,
+                InputSlot: 1,
+                AlignedByteOffset: index * 16,
+                ..transform
+            });
+        }
+    } else {
+        elements.push(D3D11_INPUT_ELEMENT_DESC {
+            SemanticIndex: 1,
+            AlignedByteOffset: std::mem::offset_of!(GpuViewportInstance, color) as u32,
+            ..transform
+        });
+    }
+    let mut layout = None;
+    // Both descriptors refer to a static semantic and the compiled VS is live.
+    unsafe { device.CreateInputLayout(&elements, vertex, Some(&mut layout)) }
+        .context("create viewport input layout")?;
+    layout.context("viewport input layout missing")
+}
+
+impl GpuViewportMeshState {
+    fn new(device: &ID3D11Device, mesh: &GpuViewportMesh) -> Result<Self> {
+        let index_count = u32::try_from(mesh.indices.len())?;
+        anyhow::ensure!(
+            index_count.is_multiple_of(3)
+                && mesh.first_instance_indices.is_multiple_of(3)
+                && mesh.first_instance_indices <= index_count
+                && mesh
+                    .indices
+                    .iter()
+                    .all(|&index| usize::from(index) < mesh.vertices.len()),
+            "invalid viewport triangle indices"
+        );
+        let vertices =
+            create_immutable_viewport_buffer(device, &mesh.vertices, D3D11_BIND_VERTEX_BUFFER)?;
+        let indices =
+            create_immutable_viewport_buffer(device, &mesh.indices, D3D11_BIND_INDEX_BUFFER)?;
+        let desc = D3D11_RASTERIZER_DESC {
+            FillMode: D3D11_FILL_SOLID,
+            CullMode: D3D11_CULL_BACK,
+            FrontCounterClockwise: true.into(),
+            DepthClipEnable: true.into(),
+            ..Default::default()
+        };
+        let mut rasterizer = None;
+        // The descriptor is initialized and D3D11 returns a new owned state.
+        unsafe { device.CreateRasterizerState(&desc, Some(&mut rasterizer)) }?;
+        log::debug!(
+            "GPU viewport: uploaded {} vertex bytes and {} index bytes",
+            size_of_val(mesh.vertices.as_slice()),
+            size_of_val(mesh.indices.as_slice())
+        );
+        Ok(Self {
+            vertices,
+            indices,
+            index_count,
+            first_instance_indices: mesh.first_instance_indices,
+            depth_state: create_depth_stencil_state(device, D3D11_DEPTH_WRITE_MASK_ALL)?,
+            rasterizer: rasterizer.context("viewport rasterizer missing")?,
+        })
+    }
+}
+
+fn create_immutable_viewport_buffer<T>(
+    device: &ID3D11Device,
+    data: &[T],
+    bind: D3D11_BIND_FLAG,
+) -> Result<ID3D11Buffer> {
+    anyhow::ensure!(!data.is_empty(), "empty viewport mesh buffer");
+    let desc = D3D11_BUFFER_DESC {
+        ByteWidth: u32::try_from(size_of_val(data))?,
+        Usage: D3D11_USAGE_IMMUTABLE,
+        BindFlags: bind.0 as u32,
+        ..Default::default()
+    };
+    let initial = D3D11_SUBRESOURCE_DATA {
+        pSysMem: data.as_ptr().cast(),
+        ..Default::default()
+    };
+    let mut buffer = None;
+    // The descriptor size matches the initialized slice D3D11 copies in this call.
+    unsafe { device.CreateBuffer(&desc, Some(&initial), Some(&mut buffer)) }?;
+    buffer.context("viewport mesh buffer missing")
+}
+
+impl GpuViewportTarget {
+    fn new(
+        devices: &DirectXRendererDevices,
+        size: Size<DevicePixels>,
+        with_depth: bool,
+    ) -> Result<Self> {
+        let desc = D3D11_TEXTURE2D_DESC {
+            Width: size.width.0 as u32,
+            Height: size.height.0 as u32,
+            MipLevels: 1,
+            ArraySize: 1,
+            Format: RENDER_TARGET_FORMAT,
+            SampleDesc: DXGI_SAMPLE_DESC {
+                Count: 1,
+                Quality: 0,
+            },
+            Usage: D3D11_USAGE_DEFAULT,
+            BindFlags: (D3D11_BIND_RENDER_TARGET | D3D11_BIND_SHADER_RESOURCE).0 as u32,
+            ..Default::default()
+        };
+        let mut texture = None;
+        let mut render_view = None;
+        let mut texture_view = None;
+        // Both views retain the texture on the renderer's device.
+        unsafe {
+            devices
+                .device
+                .CreateTexture2D(&desc, None, Some(&mut texture))?;
+            let texture = texture.context("viewport texture missing")?;
+            devices
+                .device
+                .CreateRenderTargetView(&texture, None, Some(&mut render_view))?;
+            devices
+                .device
+                .CreateShaderResourceView(&texture, None, Some(&mut texture_view))?;
+        }
+        let depth = if with_depth {
+            let (_, view) =
+                create_depth_stencil_texture_and_view(&devices.device, desc.Width, desc.Height)?;
+            Some(view.context("viewport depth view missing")?)
+        } else {
+            None
+        };
+        log::info!(
+            "GPU viewport: created offscreen target ({}x{}, depth {with_depth})",
+            desc.Width,
+            desc.Height,
+        );
+        Ok(Self {
+            size,
+            render_view,
+            texture_view,
+            depth,
+            draw: None,
+        })
+    }
+}
