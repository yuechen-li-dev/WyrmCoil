+#[cfg(test)]
+fn read_viewport_test_pixels(
+    devices: &DirectXRendererDevices,
+    target: &GpuViewportTarget,
+    positions: &[(usize, usize)],
+) -> Result<Vec<[u8; 4]>> {
+    let view = target
+        .texture_view
+        .as_ref()
+        .context("test target missing")?;
+    let source: ID3D11Texture2D = unsafe { view.GetResource()? }.cast()?;
+    let mut desc = D3D11_TEXTURE2D_DESC::default();
+    unsafe { source.GetDesc(&mut desc) };
+    desc.Usage = D3D11_USAGE_STAGING;
+    desc.BindFlags = 0;
+    desc.CPUAccessFlags = D3D11_CPU_ACCESS_READ.0 as u32;
+    let mut staging = None;
+    unsafe {
+        devices
+            .device
+            .CreateTexture2D(&desc, None, Some(&mut staging))?
+    };
+    let staging = staging.context("test staging texture missing")?;
+    let context = &devices.device_context;
+    let mut pixels = Vec::with_capacity(positions.len());
+    let mut mapped = D3D11_MAPPED_SUBRESOURCE::default();
+    for &(x, y) in positions {
+        assert!(x < desc.Width as usize && y < desc.Height as usize);
+    }
+    // Each pixel is within the mapped staging texture, including per-row padding.
+    unsafe {
+        context.CopyResource(&staging, &source);
+        context.Map(&staging, 0, D3D11_MAP_READ, 0, Some(&mut mapped))?;
+        for &(x, y) in positions {
+            let src = mapped
+                .pData
+                .cast::<u8>()
+                .add(y * mapped.RowPitch as usize + x * 4);
+            pixels.push(src.cast::<[u8; 4]>().read());
+        }
+        context.Unmap(&staging, 0);
+    }
+    Ok(pixels)
+}
