+/// A viewport pass with an ordered stream of triangle instances. The vertex entry
+/// reads the transform and color at TEXCOORD0 and TEXCOORD1, and generates the
+/// shared geometry from the vertex index. The pixel entry produces opaque color.
+/// The platform renderer owns compilation, the target, and presentation.
+#[derive(Debug)]
+pub struct GpuViewportShader {
+    /// Platform shader source. The Windows renderer consumes shader-model-4.1 HLSL.
+    pub source: String,
+    /// Vertex shader entry point.
+    pub vertex_entry: String,
+    /// Pixel shader entry point.
+    pub pixel_entry: String,
+}
+
+/// One GPU viewport instance, in input-layout order.
+#[derive(Clone, Copy, Debug, PartialEq)]
+#[repr(C)]
+pub struct GpuViewportInstance {
+    /// Clip-space center (x, y) followed by half-size (x, y).
+    pub transform: [f32; 4],
+    /// RGBA vertex color, with opaque alpha.
+    pub color: [f32; 4],
+}
+
+/// Instances in painter's order. Two objects fit inline.
+pub type GpuViewportInstances = SmallVec<[GpuViewportInstance; 2]>;
