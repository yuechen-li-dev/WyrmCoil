+struct GpuViewportPass {
+    shader: Arc<GpuViewportShader>,
+    vertex: ID3D11VertexShader,
+    pixel: ID3D11PixelShader,
+    layout: ID3D11InputLayout,
+    instance_buffer: Option<ID3D11Buffer>,
+    instance_capacity: usize,
+    target: Option<GpuViewportTarget>,
+}
+
+struct GpuViewportTarget {
+    size: Size<DevicePixels>,
+    render_view: Option<ID3D11RenderTargetView>,
+    texture_view: Option<ID3D11ShaderResourceView>,
+    instances: GpuViewportInstances,
+}
+
+fn viewport_size(surface: &PaintSurface) -> Size<DevicePixels> {
+    size(
+        DevicePixels(surface.bounds.size.width.0 as i32),
+        DevicePixels(surface.bounds.size.height.0 as i32),
+    )
+}
+
+fn surface_sprite(surface: &PaintSurface) -> PolychromeSprite {
+    PolychromeSprite {
+        order: surface.order,
+        pad: 0,
+        tile: AtlasTile {
+            // The compositor receives the target's view directly for this batch.
+            texture_id: AtlasTextureId {
+                index: 0,
+                kind: AtlasTextureKind::Polychrome,
+            },
+            tile_id: TileId(0),
+            padding: 0,
+            bounds: Bounds::new(Point::default(), viewport_size(surface)),
+        },
+        grayscale: false.into(),
+        opacity: 1.0,
+        bounds: surface.bounds,
+        content_mask: surface.content_mask,
+        corner_radii: Corners::default(),
+    }
+}
+
+impl GpuViewportPass {
+    fn prepare(
+        slot: &mut Option<Self>,
+        surface: &PaintSurface,
+        devices: &DirectXRendererDevices,
+    ) -> Result<()> {
+        let size = viewport_size(surface);
+        let instances = &surface.gpu_viewport_instances;
+        if size.width.0 <= 0 || size.height.0 <= 0 || instances.is_empty() {
+            *slot = None;
+            return Ok(());
+        }
+        if !slot
+            .as_ref()
+            .is_some_and(|pass| Arc::ptr_eq(&pass.shader, &surface.gpu_viewport))
+        {
+            *slot = None;
+            let start = std::time::Instant::now();
+            let shader = surface.gpu_viewport.clone();
+            let vertex = compile_viewport_shader(
+                &shader.source,
+                &shader.vertex_entry,
+                windows::core::s!("vs_4_1"),
+            )?;
+            let pixel = compile_viewport_shader(
+                &shader.source,
+                &shader.pixel_entry,
+                windows::core::s!("ps_4_1"),
+            )?;
+            let layout = create_viewport_input_layout(&devices.device, &vertex)?;
+            let vertex = create_vertex_shader(&devices.device, &vertex)?;
+            let pixel = create_fragment_shader(&devices.device, &pixel)?;
+            *slot = Some(Self {
+                shader,
+                vertex,
+                pixel,
+                layout,
+                instance_buffer: None,
+                instance_capacity: 0,
+                target: None,
+            });
+            log::info!(
+                "GPU viewport: SM4.1 pipeline ready in {:.2?}",
+                start.elapsed()
+            );
+        }
+        let pass = slot.as_mut().context("viewport pipeline missing")?;
+        if !pass
+            .target
+            .as_ref()
+            .is_some_and(|target| target.size == size)
+        {
+            pass.target = None;
+            pass.target = Some(GpuViewportTarget::new(devices, size)?);
+        }
+        if pass.target.as_ref().unwrap().instances != *instances {
+            pass.render(devices, instances)?;
+        }
+        Ok(())
+    }
+
+    fn render(
+        &mut self,
+        devices: &DirectXRendererDevices,
+        instances: &GpuViewportInstances,
+    ) -> Result<()> {
+        let target = self.target.as_mut().context("viewport target missing")?;
+        target.instances.clear();
+        let stride = size_of::<GpuViewportInstance>() as u32;
+        if self.instance_capacity < instances.len() {
+            let capacity = instances
+                .len()
+                .max(2)
+                .checked_next_power_of_two()
+                .context("viewport instance capacity overflow")?;
+            anyhow::ensure!(
+                capacity <= MAX_INSTANCE_BUFFER_SIZE / stride as usize,
+                "viewport instance buffer capacity too large: {capacity}"
+            );
+            let desc = D3D11_BUFFER_DESC {
+                ByteWidth: capacity as u32 * stride,
+                Usage: D3D11_USAGE_DYNAMIC,
+                BindFlags: D3D11_BIND_VERTEX_BUFFER.0 as u32,
+                CPUAccessFlags: D3D11_CPU_ACCESS_WRITE.0 as u32,
+                ..Default::default()
+            };
+            let mut buffer = None;
+            // CreateBuffer initializes the one output and copies the descriptor.
+            unsafe { devices.device.CreateBuffer(&desc, None, Some(&mut buffer)) }?;
+            self.instance_buffer = Some(buffer.context("viewport instance buffer missing")?);
+            self.instance_capacity = capacity;
+            log::debug!("GPU viewport: allocated instance buffer ({capacity} instances)");
+        }
+        let context = &devices.device_context;
+        let buffer = self
+            .instance_buffer
+            .as_ref()
+            .context("viewport instance buffer missing")?;
+        update_buffer(context, buffer, instances.as_slice())
+            .context("upload viewport instances")?;
+        let render_view = target
+            .render_view
+            .as_ref()
+            .context("viewport render view missing")?;
+        let offset = 0;
+        // The layout reads two float4 values from the bounded instance buffer.
+        // All pointers below refer to live locals or pass-owned handles for the call.
+        unsafe {
+            context.ClearRenderTargetView(render_view, &[0.0; 4]);
+            context.OMSetRenderTargets(Some(slice::from_ref(&target.render_view)), None);
+            context.OMSetBlendState(None, None, u32::MAX);
+            context.OMSetDepthStencilState(None, 0);
+            context.RSSetViewports(Some(&[D3D11_VIEWPORT {
+                Width: target.size.width.0 as f32,
+                Height: target.size.height.0 as f32,
+                MaxDepth: 1.0,
+                ..Default::default()
+            }]));
+            context.IASetPrimitiveTopology(D3D_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+            context.IASetInputLayout(&self.layout);
+            context.IASetVertexBuffers(
+                0,
+                1,
+                Some(&self.instance_buffer),
+                Some(&stride),
+                Some(&offset),
+            );
+            context.VSSetShader(&self.vertex, None);
+            context.PSSetShader(&self.pixel, None);
+            context.DrawInstanced(3, instances.len() as u32, 0, 0);
+            context.OMSetRenderTargets(None, None);
+            context.IASetVertexBuffers(0, 1, Some(&None), Some(&stride), Some(&offset));
+            context.IASetInputLayout(None);
+            context.VSSetShader(None, None);
+            context.PSSetShader(None, None);
+        }
+        target.instances.extend_from_slice(instances);
+        log::trace!(
+            "GPU viewport: one DrawInstanced, {} instances, {} uploaded bytes",
+            instances.len(),
+            size_of_val(instances.as_slice())
+        );
+        Ok(())
+    }
+}
+
+fn create_viewport_input_layout(device: &ID3D11Device, vertex: &[u8]) -> Result<ID3D11InputLayout> {
+    let transform = D3D11_INPUT_ELEMENT_DESC {
+        SemanticName: windows::core::s!("TEXCOORD"),
+        Format: DXGI_FORMAT_R32G32B32A32_FLOAT,
+        InputSlotClass: D3D11_INPUT_PER_INSTANCE_DATA,
+        InstanceDataStepRate: 1,
+        ..Default::default()
+    };
+    let color = D3D11_INPUT_ELEMENT_DESC {
+        SemanticIndex: 1,
+        AlignedByteOffset: std::mem::offset_of!(GpuViewportInstance, color) as u32,
+        ..transform
+    };
+    let mut layout = None;
+    // Both descriptors refer to a static semantic and the compiled VS is live.
+    unsafe { device.CreateInputLayout(&[transform, color], vertex, Some(&mut layout)) }
+        .context("create viewport input layout")?;
+    layout.context("viewport input layout missing")
+}
+
+impl GpuViewportTarget {
+    fn new(devices: &DirectXRendererDevices, size: Size<DevicePixels>) -> Result<Self> {
+        let desc = D3D11_TEXTURE2D_DESC {
+            Width: size.width.0 as u32,
+            Height: size.height.0 as u32,
+            MipLevels: 1,
+            ArraySize: 1,
+            Format: RENDER_TARGET_FORMAT,
+            SampleDesc: DXGI_SAMPLE_DESC {
+                Count: 1,
+                Quality: 0,
+            },
+            Usage: D3D11_USAGE_DEFAULT,
+            BindFlags: (D3D11_BIND_RENDER_TARGET | D3D11_BIND_SHADER_RESOURCE).0 as u32,
+            ..Default::default()
+        };
+        let mut texture = None;
+        let mut render_view = None;
+        let mut texture_view = None;
+        // Both views retain the texture on the renderer's device.
+        unsafe {
+            devices
+                .device
+                .CreateTexture2D(&desc, None, Some(&mut texture))?;
+            let texture = texture.context("viewport texture missing")?;
+            devices
+                .device
+                .CreateRenderTargetView(&texture, None, Some(&mut render_view))?;
+            devices
+                .device
+                .CreateShaderResourceView(&texture, None, Some(&mut texture_view))?;
+        }
+        log::info!(
+            "GPU viewport: created offscreen target ({}x{})",
+            desc.Width,
+            desc.Height,
+        );
+        Ok(Self {
+            size,
+            render_view,
+            texture_view,
+            instances: GpuViewportInstances::new(),
+        })
+    }
+}
+
+#[cfg(test)]
+#[::core::prelude::v1::test]
+#[ignore = "requires a Direct3D 11 device"]
+fn gpu_viewport_reuses_and_resizes_its_target_then_drops_the_pass() -> Result<()> {
+    let devices = DirectXRendererDevices::new(&DirectXDevices::new()?, true)?;
+    set_rasterizer_state(&devices.device, &devices.device_context)?;
+    let shader = Arc::new(GpuViewportShader {
+        source: r#"
+            struct Varying { float4 position : SV_Position; float4 color : TEXCOORD0; };
+            Varying vs(uint id : SV_VertexID, float4 transform : TEXCOORD0, float4 color : TEXCOORD1) {
+                float2 local = float2(id == 2 ? 0 : (id == 0 ? -1 : 1), id == 2 ? 1 : -1);
+                Varying output;
+                output.position = float4(transform.xy + local * transform.zw, 0, 1);
+                output.color = color;
+                return output;
+            }
+            float4 ps(Varying input) : SV_Target { return input.color; }
+        "#
+        .into(),
+        vertex_entry: "vs".into(),
+        pixel_entry: "ps".into(),
+    });
+    let bounds = Bounds::new(
+        point(ScaledPixels(0.0), ScaledPixels(0.0)),
+        size(ScaledPixels(24.0), ScaledPixels(16.0)),
+    );
+    let mut surface = PaintSurface {
+        order: 0,
+        bounds,
+        content_mask: ContentMask { bounds },
+        gpu_viewport: shader.clone(),
+        gpu_viewport_instances: GpuViewportInstances::from_slice(&[
+            GpuViewportInstance {
+                transform: [-0.5, 0.0, 0.3, 0.5],
+                color: [1.0, 0.0, 0.0, 1.0],
+            },
+            GpuViewportInstance {
+                transform: [0.5, 0.0, 0.3, 0.5],
+                color: [0.0, 1.0, 0.0, 1.0],
+            },
+        ]),
+    };
+    let mut pass = None;
+    GpuViewportPass::prepare(&mut pass, &surface, &devices)?;
+    let first = pass.as_ref().unwrap().target.as_ref().unwrap();
+    assert_eq!(first.size, size(DevicePixels(24), DevicePixels(16)));
+    let first_view = first.texture_view.clone();
+    let vertex_shader = pass.as_ref().unwrap().vertex.clone();
+    let input_layout = pass.as_ref().unwrap().layout.clone();
+    let instance_buffer = pass.as_ref().unwrap().instance_buffer.clone();
+    assert_eq!(
+        read_viewport_test_pixels(&devices, first, &[(6, 8), (18, 8), (12, 8)])?,
+        [[0, 0, 255, 255], [0, 255, 0, 255], [0, 0, 0, 0]]
+    );
+    GpuViewportPass::prepare(&mut pass, &surface, &devices)?;
+    assert_eq!(
+        pass.as_ref().unwrap().target.as_ref().unwrap().texture_view,
+        first_view
+    );
+    surface.gpu_viewport_instances[1].transform = surface.gpu_viewport_instances[0].transform;
+    GpuViewportPass::prepare(&mut pass, &surface, &devices)?;
+    let overlapping = pass.as_ref().unwrap();
+    assert_eq!(overlapping.instance_buffer, instance_buffer);
+    assert_eq!(
+        overlapping.target.as_ref().unwrap().texture_view,
+        first_view
+    );
+    assert_eq!(
+        read_viewport_test_pixels(
+            &devices,
+            overlapping.target.as_ref().unwrap(),
+            &[(6, 8), (18, 8)]
+        )?,
+        [[0, 255, 0, 255], [0, 0, 0, 0]]
+    );
+
+    surface.bounds.size.width = ScaledPixels(32.0);
+    GpuViewportPass::prepare(&mut pass, &surface, &devices)?;
+    let resized = pass.as_ref().unwrap();
+    assert_eq!(resized.vertex, vertex_shader);
+    assert_eq!(resized.layout, input_layout);
+    assert_eq!(resized.instance_buffer, instance_buffer);
+    assert_eq!(
+        resized.target.as_ref().unwrap().size,
+        size(DevicePixels(32), DevicePixels(16))
+    );
+    assert_ne!(resized.target.as_ref().unwrap().texture_view, first_view);
+
+    surface.bounds.size.width = ScaledPixels(0.0);
+    GpuViewportPass::prepare(&mut pass, &surface, &devices)?;
+    assert!(pass.is_none());
+    assert_eq!(Arc::strong_count(&shader), 2);
+    Ok(())
+}
