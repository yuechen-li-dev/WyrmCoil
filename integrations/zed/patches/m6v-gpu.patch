+
+struct ExternalViewport {
+    session: Box<dyn GpuViewportProducerSession>,
+    shared: Option<SharedViewportTexture>,
+}
+
+struct SharedViewportTexture {
+    texture: ID3D11Texture2D,
+    mutex: IDXGIKeyedMutex,
+    copy_done: ID3D11Query,
+    submitted: Option<GpuViewportDraw>,
+    copying: bool,
+}
+
+impl ExternalViewport {
+    fn new(producer: &dyn GpuViewportProducer, devices: &DirectXRendererDevices) -> Result<Self> {
+        // The adapter is retained by the same renderer that owns the D3D11 device.
+        let adapter = unsafe { devices.adapter.GetDesc1() }?;
+        let mut luid = [0; 8];
+        luid[..4].copy_from_slice(&adapter.AdapterLuid.LowPart.to_le_bytes());
+        luid[4..].copy_from_slice(&adapter.AdapterLuid.HighPart.to_le_bytes());
+        let session = producer
+            .create(luid)
+            .map_err(|error| anyhow::anyhow!(error))?;
+        log::info!("GPU viewport: Vulkan matched DXGI LUID {luid:02x?}");
+        Ok(Self {
+            session,
+            shared: None,
+        })
+    }
+
+    fn prepare(
+        &mut self,
+        target: &mut Option<GpuViewportTarget>,
+        size: Size<DevicePixels>,
+        draw: &GpuViewportDraw,
+        devices: &DirectXRendererDevices,
+    ) -> Result<bool> {
+        let GpuViewportDraw::Mesh(instances) = draw else {
+            anyhow::bail!("external viewport requires indexed geometry");
+        };
+        let context = &devices.device_context;
+        let resizing = !target.as_ref().is_some_and(|target| target.size == size);
+        if resizing && let Some(target) = target {
+            target.draw = None;
+        }
+        if let Some(shared) = &mut self.shared {
+            if shared.copying {
+                // GetData's wrapper erases S_FALSE. Poll without flushing or waiting.
+                let status = unsafe {
+                    (context.vtable().GetData)(
+                        context.as_raw(),
+                        shared.copy_done.as_raw(),
+                        std::ptr::null_mut(),
+                        0,
+                        D3D11_ASYNC_GETDATA_DONOTFLUSH.0 as u32,
+                    )
+                };
+                if status == S_FALSE {
+                    return Ok(resizing
+                        || target.as_ref().and_then(|target| target.draw.as_ref()) != Some(draw));
+                }
+                anyhow::ensure!(
+                    status == S_OK,
+                    "D3D11 viewport copy query returned {status:?}"
+                );
+                shared.copying = false;
+            }
+            if shared.submitted.is_some() {
+                if !self
+                    .session
+                    .ready()
+                    .map_err(|error| anyhow::anyhow!(error))?
+                {
+                    return Ok(true);
+                }
+                if !resizing {
+                    let target = target
+                        .as_mut()
+                        .context("missing external viewport target")?;
+                    let view = target
+                        .texture_view
+                        .as_ref()
+                        .context("missing viewport texture view")?;
+                    // The private destination has the same format and extent as the shared image.
+                    let destination = unsafe { view.GetResource() }?;
+                    // AcquireSync's Result wrapper would accept WAIT_TIMEOUT and WAIT_ABANDONED.
+                    let status =
+                        unsafe { (shared.mutex.vtable().AcquireSync)(shared.mutex.as_raw(), 1, 0) };
+                    if status.0 == WAIT_TIMEOUT.0 as i32 {
+                        return Ok(true);
+                    }
+                    anyhow::ensure!(
+                        status == S_OK,
+                        "shared viewport acquire returned {status:?}"
+                    );
+                    unsafe {
+                        context.CopyResource(&destination, &shared.texture);
+                        shared.mutex.ReleaseSync(0)?;
+                        context.End(&shared.copy_done);
+                    }
+                    shared.copying = true;
+                    target.draw = shared.submitted.take();
+                    log::trace!("GPU viewport: composed a Vulkan frame through a D3D11 GPU copy");
+                    return Ok(target.draw.as_ref() != Some(draw));
+                }
+            }
+        }
+        if resizing {
+            let new_target = GpuViewportTarget::new(devices, size, false)?;
+            let shared = SharedViewportTexture::new(devices, size, self.session.as_mut())?;
+            self.shared = Some(shared);
+            *target = Some(new_target);
+        }
+        if target.as_ref().and_then(|target| target.draw.as_ref()) == Some(draw) {
+            return Ok(false);
+        }
+        // A new shared texture starts at key 0. Reuse starts only after the
+        // previous D3D11 copy query has completed and returned ownership at key 0.
+        let submitted =
+            unsafe { self.session.submit(instances) }.map_err(|error| anyhow::anyhow!(error))?;
+        if submitted {
+            self.shared
+                .as_mut()
+                .context("missing shared viewport texture")?
+                .submitted = Some(draw.clone());
+        }
+        Ok(true)
+    }
+}
+
+impl SharedViewportTexture {
+    fn new(
+        devices: &DirectXRendererDevices,
+        size: Size<DevicePixels>,
+        session: &mut dyn GpuViewportProducerSession,
+    ) -> Result<Self> {
+        let width = u32::try_from(size.width.0)?;
+        let height = u32::try_from(size.height.0)?;
+        let descriptor = D3D11_TEXTURE2D_DESC {
+            Width: width,
+            Height: height,
+            MipLevels: 1,
+            ArraySize: 1,
+            Format: RENDER_TARGET_FORMAT,
+            SampleDesc: DXGI_SAMPLE_DESC {
+                Count: 1,
+                Quality: 0,
+            },
+            Usage: D3D11_USAGE_DEFAULT,
+            BindFlags: (D3D11_BIND_SHADER_RESOURCE | D3D11_BIND_RENDER_TARGET).0 as u32,
+            MiscFlags: (D3D11_RESOURCE_MISC_SHARED_NTHANDLE | D3D11_RESOURCE_MISC_SHARED_KEYEDMUTEX)
+                .0 as u32,
+            ..Default::default()
+        };
+        let mut texture = None;
+        let mut copy_done = None;
+        // Both outputs are new D3D11 objects on the editor's existing device.
+        unsafe {
+            devices
+                .device
+                .CreateTexture2D(&descriptor, None, Some(&mut texture))?;
+            devices.device.CreateQuery(
+                &D3D11_QUERY_DESC {
+                    Query: D3D11_QUERY_EVENT,
+                    MiscFlags: 0,
+                },
+                Some(&mut copy_done),
+            )?;
+        }
+        let texture = texture.context("shared viewport texture missing")?;
+        let copy_done = copy_done.context("viewport copy query missing")?;
+        let mutex = texture.cast::<IDXGIKeyedMutex>()?;
+        let resource = texture.cast::<IDXGIResource1>()?;
+        // The Vulkan import retains the memory. The application closes its NT handle.
+        unsafe {
+            let handle = resource.CreateSharedHandle(
+                None,
+                (DXGI_SHARED_RESOURCE_READ | DXGI_SHARED_RESOURCE_WRITE).0,
+                windows::core::PCWSTR::null(),
+            )?;
+            let _owner = OwnedHandle::from_raw_handle(handle.0);
+            session
+                .attach(handle.0 as usize, width, height)
+                .map_err(|error| anyhow::anyhow!(error))?;
+        }
+        Ok(Self {
+            texture,
+            mutex,
+            copy_done,
+            submitted: None,
+            copying: false,
+        })
+    }
 }
 
