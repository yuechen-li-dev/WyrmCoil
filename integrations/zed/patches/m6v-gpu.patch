+/// Creates one producer on the physical adapter selected by the compositor.
+#[cfg(target_os = "windows")]
+pub trait GpuViewportProducer: std::fmt::Debug + Send + Sync {
+    /// Creates a session compatible with the compositor's DXGI adapter.
+    fn create(&self, adapter_luid: [u8; 8]) -> Result<Box<dyn GpuViewportProducerSession>, String>;
+    /// Publishes composition status and whether a subsequent frame should poll.
+    fn report(&self, status: String, pending: bool);
+    /// Returns the current composition status for the viewport UI.
+    fn status(&self) -> String;
+    /// Checks whether the painted viewport needs another frame.
+    fn pending(&self) -> bool;
