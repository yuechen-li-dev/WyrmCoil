+pub trait GpuViewportProducerSession {
+    /// Display name for the active backend and device.
+    fn name(&self) -> &str;
+    /// Polls completion of the last submission without waiting.
+    fn ready(&self) -> Result<bool, String>;
+    /// Imports a single-mip BGRA8 UNORM texture with NT and keyed sharing.
+    ///
+    /// # Safety
+    /// The handle must describe a live, compatible texture of the given size,
+    /// and the previous texture must no longer be in use.
+    unsafe fn attach(&mut self, nt_handle: usize, width: u32, height: u32) -> Result<(), String>;
+    /// Submits work with keyed-mutex acquire at key 0 and release at key 1.
+    ///
+    /// # Safety
+    /// The compositor must have finished handing off the attached texture at key 0.
+    unsafe fn submit(&mut self, instances: &[GpuViewportMeshInstance]) -> Result<bool, String>;
 }
 
