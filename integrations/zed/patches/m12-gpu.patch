+fn viewport_diagnostics() -> bool {
+    static ENABLED: OnceLock<bool> = OnceLock::new();
+    *ENABLED.get_or_init(|| std::env::var("WYRMCOIL_VULKAN_STARTUP").as_deref() == Ok("1"))
+}
+
+fn viewport_time(stage: &str, time: Duration) {
+    log::info!(
+        "wyrmcoil_vk stage={stage} event=end thread={:?} elapsed_us={}",
+        std::thread::current().id(), time.as_micros()
+    );
+}
+
+fn viewport_stage<T>(stage: &str, work: impl FnOnce() -> T) -> T {
+    if !viewport_diagnostics() {
+        return work();
+    }
+    let start = Instant::now();
+    log::info!("wyrmcoil_vk stage={stage} event=begin thread={:?}", std::thread::current().id());
+    let result = work();
+    viewport_time(stage, start.elapsed());
+    result
 }
 
