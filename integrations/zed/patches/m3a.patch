+    /// Paint a GPU viewport surface at the current scene order, if supported.
+    pub fn paint_gpu_viewport(
+        &mut self,
+        bounds: Bounds<Pixels>,
+        shader: &Arc<crate::GpuViewportShader>,
+    ) -> bool {
+        if !self.platform_window.supports_gpu_viewport() {
+            return false;
+        }
+        self.invalidator.debug_assert_paint();
+        #[cfg(target_os = "windows")]
+        {
+            let bounds = self.snap_bounds(bounds);
+            let content_mask = self.snapped_content_mask();
+            if !bounds.intersect(&content_mask.bounds).is_empty() {
+                self.next_frame.scene.insert_primitive(crate::PaintSurface {
+                    order: 0,
+                    bounds,
+                    content_mask,
+                    gpu_viewport: shader.clone(),
+                });
+            }
+            true
+        }
+        #[cfg(not(target_os = "windows"))]
+        {
+            let _ = (bounds, shader);
+            false
+        }
+    }
