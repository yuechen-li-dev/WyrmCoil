type ClipPosition = float4 @space(clip.position);
stream VertexInvocation { [builtin(vertex_id)] Id: u32; }
stream RasterVertex { Position: ClipPosition; }

shader PreviewTriangle {
    stage vertex fn VS(input: VertexInvocation) -> RasterVertex {
        var x: f32 = -0.95;
        var y: f32 = -0.90;
        if input.Id == 1u {
            x = 0.95;
        }
        if input.Id == 2u {
            x = 0.0;
            y = 0.95;
        }
        return RasterVertex { Position: float4(x, y, 0.0, 1.0); };
    }

    stage pixel fn PS() -> float4 {
        return float4(0.40, 0.83, 0.93, 1.0);
    }
}
