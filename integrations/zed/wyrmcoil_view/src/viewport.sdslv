type ClipPosition = float4 @space(clip.position);
stream VertexInvocation { [builtin(vertex_id)] Id: u32; }
stream ViewportInstance {
    [location(0)] Transform: float4;
    [location(1)] Color: float4;
}
stream RasterVertex {
    Position: ClipPosition;
    [location(0)] Color: float4;
}

shader PreviewInstances {
    stage vertex fn VS(input: VertexInvocation, instance: ViewportInstance) -> RasterVertex {
        var x: f32 = -0.95;
        var y: f32 = -0.90;
        if input.Id == 1u {
            x = 0.95;
        }
        if input.Id == 2u {
            x = 0.0;
            y = 0.95;
        }
        return RasterVertex {
            Position: float4(instance.Transform.x + x * instance.Transform.z,
                             instance.Transform.y + y * instance.Transform.w, 0.0, 1.0);
            Color: instance.Color;
        };
    }

    stage pixel fn PS(input: RasterVertex) -> float4 {
        return input.Color;
    }
}
